  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"TC1 Login Success\" && pm.response.code === 200) {",
          "    pm.environment.set(\"token\", pm.response.json().token);",
          "}",
          "",
          "const expectedStatuses = {",
          "    \"TC4 Get Student Success\": 200,",
          "    \"TC5 Get Student Not Found\": 404,",
          "    \"TC6 Get Student Unauthorized\": 401,",
          "    \"TC7 Get Student Invalid Token\": 401,",
          "    \"TC8 Course Sucessful1 SoftTest\": 200,",
          "    \"TC9 Course Sucessful2 WebApp\": 200,",
          "    \"TC10 Course Sucessful3 APIDev\": 200,",
          "    \"registration sucessful\": 201,",
          "    \"Delete-Course of Student\": 200,",
          "    \"TC11 Boundary 22 Accepted\": 201,",
          "    \"TC12 Over 22 Rejected\": 400,",
          "    \"TC13 Course Full\": 409,",
          "    \"TC14 Duplicate Registration\": 409,",
          "    \"TC15 Student Not Found\": 404,",
          "    \"TC16 Course Not Found\": 404",
          "};",
          "",
          "const expectedStatus = expectedStatuses[pm.info.requestName];",
          "if (expectedStatus !== undefined) {",
          "    pm.test(`Status is ${expectedStatus}`, function () {",
          "        pm.response.to.have.status(expectedStatus);",
          "    });",
          "}"
        ]
      }
    }
